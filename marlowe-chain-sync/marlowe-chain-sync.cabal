cabal-version: 3.4
name:          marlowe-chain-sync
version:       1.0.0
synopsis:      Cardano chain sync system for thee Marlowe Runtime
description:
  Marlowe runtime component for Cardano node synchronization. Communicates with
  downstream compoents using the Chain Sync protocol, which provides
  efficient push and pull-based traversal of the cardano blockchain.

bug-reports:   https://github.com/input-output-hk/marlowe-cardano/issues
license:       Apache-2.0
author:        Jamie Bertram
maintainer:    jamie.bertram@iohk.io
stability:     experimental
category:      Language
license-files:
  LICENSE
  NOTICE

source-repository head
  type:     git
  location: https://github.com/input-output-hk/marlowe-cardano
  subdir:   marlowe-chain-sync

common lang
  default-language:   Haskell2010
  default-extensions:
    BlockArguments
    DeriveAnyClass
    DeriveFoldable
    DeriveFunctor
    DeriveGeneric
    DeriveLift
    DeriveTraversable
    DerivingStrategies
    DerivingVia
    ExplicitForAll
    GeneralizedNewtypeDeriving
    LambdaCase
    NamedFieldPuns
    NumericUnderscores
    OverloadedStrings
    RecordWildCards
    ScopedTypeVariables
    StandaloneDeriving
    TupleSections
    TypeApplications

  ghc-options:
    -Wall -Wnoncanonical-monad-instances -Wincomplete-uni-patterns
    -Wincomplete-record-updates -Wredundant-constraints -Widentities

library
  import:          lang
  hs-source-dirs:  src
  exposed-modules:
    Language.Marlowe.Runtime.Cardano.Api
    Language.Marlowe.Runtime.Cardano.Feature
    Language.Marlowe.Runtime.ChainSync.Api
    Language.Marlowe.Runtime.ChainSync.Database.PostgreSQL.Allegra
    Language.Marlowe.Runtime.ChainSync.Database.PostgreSQL.Alonzo
    Language.Marlowe.Runtime.ChainSync.Database.PostgreSQL.Babbage
    Language.Marlowe.Runtime.ChainSync.Database.PostgreSQL.Byron
    Language.Marlowe.Runtime.ChainSync.Database.PostgreSQL.Cardano
    Language.Marlowe.Runtime.ChainSync.Database.PostgreSQL.Conway
    Language.Marlowe.Runtime.ChainSync.Database.PostgreSQL.Mary
    Language.Marlowe.Runtime.ChainSync.Database.PostgreSQL.Shelley
    Language.Marlowe.Runtime.ChainSync.Database.PostgreSQL.Types

  other-modules:
  build-depends:
    , aeson
    , attoparsec
    , base >=4.9 && <5
    , base16
    , binary ^>=0.8.8
    , bytestring
    , cardano-api
    , cardano-binary
    , cardano-crypto-class
    , cardano-crypto-wrapper
    , cardano-ledger-allegra
    , cardano-ledger-alonzo
    , cardano-ledger-babbage
    , cardano-ledger-binary
    , cardano-ledger-byron
    , cardano-ledger-conway
    , cardano-ledger-core
    , cardano-ledger-mary
    , cardano-ledger-shelley
    , cassava
    , containers ^>=0.6.5
    , deepseq
    , eventuo11y-otel ^>=0.2
    , groups
    , hashable >=1.3 && <2
    , hs-opentelemetry-api
    , marlowe-adapter
    , marlowe-protocols ==0.3.0.0
    , microlens
    , nonempty-containers
    , ouroboros-consensus
    , ouroboros-consensus-cardano
    , plutus-core
    , plutus-ledger-api
    , postgresql-simple
    , reflection
    , scientific
    , serialise ^>=0.2.6
    , sop-core
    , sop-extras
    , strict-sop-core
    , text
    , these >=1.1 && <2
    , time >=1.9 && <2
    , vector ^>=0.13

library libchainsync
  import:          lang
  hs-source-dirs:  libchainsync
  visibility:      public
  exposed-modules:
    Language.Marlowe.Runtime.ChainSync
    Language.Marlowe.Runtime.ChainSync.Database
    Language.Marlowe.Runtime.ChainSync.Database.PostgreSQL
    Language.Marlowe.Runtime.ChainSync.JobServer
    Language.Marlowe.Runtime.ChainSync.NodeClient
    Language.Marlowe.Runtime.ChainSync.QueryServer
    Language.Marlowe.Runtime.ChainSync.Server

  other-modules:
  build-depends:
    , async-components ==0.1.1.0
    , base >=4.9 && <5
    , bytestring
    , cardano-api
    , cardano-binary
    , cardano-ledger-binary
    , co-log ^>=0.6
    , containers ^>=0.6.5
    , eventuo11y >=0.9 && <0.11
    , eventuo11y-extras ==0.1.1.0
    , eventuo11y-otel ^>=0.2
    , foldl >=1.4 && <2
    , hasql >=1.6 && <2
    , hasql-pool
    , hasql-th ^>=0.4
    , hasql-transaction
    , hs-opentelemetry-api
    , marlowe-chain-sync ==1.0.0
    , marlowe-protocols ==0.3.0.0
    , nonempty-containers ^>=0.3.4
    , ouroboros-network-protocols
    , stm ^>=2.5
    , text
    , transformers
    , unliftio ^>=0.2.1
    , vector ^>=0.13

library chain-indexer
  import:          lang
  hs-source-dirs:  chain-indexer
  visibility:      public
  exposed-modules:
    Language.Marlowe.Runtime.ChainIndexer
    Language.Marlowe.Runtime.ChainIndexer.Database
    Language.Marlowe.Runtime.ChainIndexer.Database.PostgreSQL
    Language.Marlowe.Runtime.ChainIndexer.Genesis
    Language.Marlowe.Runtime.ChainIndexer.NodeClient
    Language.Marlowe.Runtime.ChainIndexer.Store

  other-modules:
  build-depends:
    , async-components ==0.1.1.0
    , base >=4.9 && <5
    , base16
    , bytestring
    , cardano-api
    , cardano-crypto-wrapper
    , cardano-ledger-alonzo
    , cardano-ledger-byron
    , cardano-ledger-core
    , cardano-ledger-shelley
    , cardano-strict-containers
    , cassava
    , co-log ^>=0.6
    , containers ^>=0.6.5
    , eventuo11y >=0.9 && <0.11
    , eventuo11y-extras ==0.1.1.0
    , eventuo11y-otel ^>=0.2
    , hasql >=1.6 && <2
    , hasql-pool
    , hasql-th ^>=0.4
    , hasql-transaction
    , hs-opentelemetry-api
    , marlowe-chain-sync ==1.0.0
    , mtl >=2.2 && <3
    , ouroboros-consensus-cardano
    , ouroboros-network-api
    , postgresql-simple
    , profunctors >=5.6 && <6
    , stm ^>=2.5
    , stm-delay ^>=0.1.1
    , text
    , time >=1.9 && <2
    , transformers
    , unliftio ^>=0.2.1
    , vector ^>=0.13
    , witherable

library plutus-compat
  import:          lang
  hs-source-dirs:  plutus-compat
  visibility:      public
  exposed-modules: Language.Marlowe.Runtime.Plutus.V2.Api
  other-modules:
  build-depends:
    , base >=4.9 && <5
    , base16
    , cardano-api
    , cardano-ledger-binary
    , cardano-ledger-byron
    , containers ^>=0.6.5
    , marlowe-chain-sync ==1.0.0
    , plutus-ledger-api
    , plutus-tx

library gen
  import:          lang
  hs-source-dirs:  gen
  visibility:      public
  exposed-modules: Language.Marlowe.Runtime.ChainSync.Gen
  other-modules:
  build-depends:
    , base >=4.9 && <5
    , bytestring
    , cardano-api
    , cardano-api-gen
    , containers ^>=0.6.5
    , hedgehog-quickcheck ^>=0.1
    , marlowe-chain-sync ==1.0.0
    , marlowe-protocols ==0.3.0.0
    , nonempty-containers ^>=0.3.4
    , ouroboros-consensus
    , QuickCheck >=2.14 && <3
    , sop-core
    , sop-extras
    , strict-sop-core
    , text
    , time >=1.9 && <2

test-suite marlowe-chain-sync-test
  import:             lang
  hs-source-dirs:     test
  type:               exitcode-stdio-1.0
  main-is:            Spec.hs
  other-modules:
    Language.Marlowe.Runtime.ChainSync.ApiSpec
    Paths_marlowe_chain_sync

  build-depends:
    , base >=4.9 && <5
    , hspec >=2.10 && <3
    , marlowe-chain-sync ==1.0.0
    , marlowe-chain-sync:gen
    , marlowe-protocols ==0.3.0.0

  build-tool-depends: hspec-discover:hspec-discover
  ghc-options:        -threaded

executable marlowe-chain-indexer
  import:          lang
  ghc-options:     -threaded
  hs-source-dirs:  marlowe-chain-indexer
  main-is:         Main.hs
  other-modules:
    Logging
    Options
    Paths_marlowe_chain_sync

  autogen-modules: Paths_marlowe_chain_sync
  build-depends:
    , aeson
    , async-components ==0.1.1.0
    , base >=4.9 && <5
    , bytestring
    , cardano-api
    , cardano-crypto-wrapper
    , cardano-ledger-byron
    , eventuo11y >=0.9 && <0.11
    , eventuo11y-extras ==0.1.1.0
    , eventuo11y-otel ^>=0.2
    , hasql >=1.6 && <2
    , hasql-pool
    , hs-opentelemetry-sdk
    , marlowe-chain-sync:chain-indexer
    , mtl >=2.2 && <3
    , optparse-applicative
    , postgresql-libpq
    , text
    , time >=1.9 && <2
    , transformers
    , unliftio ^>=0.2.1

executable marlowe-chain-sync
  import:          lang
  ghc-options:     -threaded
  hs-source-dirs:  marlowe-chain-sync
  main-is:         Main.hs
  other-modules:
    Logging
    Options
    Paths_marlowe_chain_sync

  autogen-modules: Paths_marlowe_chain_sync
  build-depends:
    , async-components ==0.1.1.0
    , base >=4.9 && <5
    , bytestring
    , cardano-api
    , eventuo11y >=0.9 && <0.11
    , eventuo11y-extras ==0.1.1.0
    , eventuo11y-otel ^>=0.2
    , hasql >=1.6 && <2
    , hasql-pool
    , hs-opentelemetry-sdk
    , marlowe-chain-sync ==1.0.0
    , marlowe-chain-sync:libchainsync
    , marlowe-protocols ==0.3.0.0
    , mtl >=2.2 && <3
    , network >=3.1 && <4
    , optparse-applicative
    , postgresql-libpq
    , text
    , unliftio ^>=0.2.1

executable marlowe-chain-copy
  import:          lang
  ghc-options:     -threaded
  hs-source-dirs:  marlowe-chain-copy
  main-is:         Main.hs
  other-modules:
