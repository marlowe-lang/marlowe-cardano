cabal-version: 3.4
name:          marlowe-optparse
version:       0.1.0.0
synopsis:      Shared optparse and output formatting helpers for Marlowe CLI tools.

library
  default-language:   Haskell2010
  hs-source-dirs:     src
  default-extensions:
    BlockArguments
    DeriveGeneric
    DerivingStrategies
    ImportQualifiedPost
    LambdaCase
    OverloadedStrings
    ScopedTypeVariables

  ghc-options:
    -Wall -Wnoncanonical-monad-instances -Wunused-packages
    -Wincomplete-uni-patterns -Wincomplete-record-updates
    -Wredundant-constraints -Widentities

  exposed-modules:
    Marlowe.OptParse.MessageFormat

  build-depends:
    , aeson
    , aeson-pretty
    , base >=4.9 && <5
    , bytestring
    , optparse-applicative
    , text
    , yaml