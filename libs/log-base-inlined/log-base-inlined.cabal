cabal-version: 3.4
name:          log-base-inlined
version:       0.0.1.0
synopsis:      A formatter for log-base which squashes the log message into a single line.
bug-reports:   https://github.com/marlowe-lang/marlowe-plutus/issues
license:       Apache-2.0
author:        Tomasz Rybarczyk
maintainer:    tomasz.rybarczyk@marlowe-lang.org
stability:     experimental
category:      Language

source-repository head
  type:     git
  location: https://github.com/marlowe-lang/marlowe-plutus
  subdir:   async-components

library
  default-language:   Haskell2010
  hs-source-dirs:     src
  default-extensions:
    BangPatterns
    BlockArguments
    ConstraintKinds
    DataKinds
    DefaultSignatures
    DeriveAnyClass
    DeriveDataTypeable
    DeriveFoldable
    DeriveFunctor
    DeriveGeneric
    DeriveLift
    DeriveTraversable
    DerivingStrategies
    DerivingVia
    DoAndIfThenElse
    DuplicateRecordFields
    ExplicitForAll
    FlexibleContexts
    FlexibleInstances
    GADTs
    GeneralizedNewtypeDeriving
    ImportQualifiedPost
    LambdaCase
    MultiParamTypeClasses
    NamedFieldPuns
    NumericUnderscores
    OverloadedStrings
    OverloadedRecordDot
    PatternSynonyms
    RankNTypes
    RecordWildCards
    ScopedTypeVariables
    StandaloneDeriving
    TupleSections
    TypeApplications
    TypeFamilies
    TypeOperators
    ViewPatterns

  ghc-options:
    -Wall -Wnoncanonical-monad-instances -Wunused-packages
    -Wincomplete-uni-patterns -Wincomplete-record-updates
    -Wredundant-constraints -Widentities

  exposed-modules:
    Log.Backend.StandardOutputInlined

  build-depends:
    , aeson
    , base >=4.9 && <5
    , bytestring
    , log-base
    , text
    , time
    , unliftio-core
