    Language.Marlowe.Runtime.Web.Role.API
    Language.Marlowe.Runtime.Web.Role.Server
    Language.Marlowe.Runtime.Web.Role.TokenFilter
    Language.Marlowe.Runtime.Web.Runtime.Types
    Language.Marlowe.Runtime.Web.Server
    Language.Marlowe.Runtime.Web.Server.ApiError
    Language.Marlowe.Runtime.Web.Server.DTO
    Language.Marlowe.Runtime.Web.Server.Monad
    Language.Marlowe.Runtime.Web.Server.OpenAPI
    Language.Marlowe.Runtime.Web.Server.Util
    Language.Marlowe.Runtime.Web.Status
    Language.Marlowe.Runtime.Web.Tx.API
    Language.Marlowe.Runtime.Web.Withdrawal.API
    Language.Marlowe.Runtime.Web.Withdrawal.Server

executable server
  import:          lang
  hs-source-dirs:  server
  main-is:         Main.hs
  ghc-options:
    -threaded -j8
  other-modules:
    Paths_marlowe_runtime
    Marlowe.Runtime.Server.Contrib.Servant.Err500
    Marlowe.Runtime.Server.Contrib.Servant.ResponseRewriterMiddleware
  build-depends:
    , aeson
    , aeson-pretty
    , async-components
    , base
    , base16-bytestring
    , binary
    , bytestring
    , cardano-api
    , cardano-crypto-class
    , cardano-ledger-alonzo
    , cardano-ledger-api
    , cardano-ledger-binary
    , cardano-ledger-core
    , case-insensitive
    , co-log
    , containers
    , deepseq
    , errors
    , exceptions
    , foldl
    , hashable
    , hasql
    , hasql-dynamic-syntax
    , hasql-implicits
    , hasql-pool
    , hasql-th >=0.5
    , hasql-transaction
    , http-conduit
    , http-media
    , http-types
    , insert-ordered-containers
    , lens
    , lifted-base
    , log-base
    , log-base-inlined
    , marlowe-binaries:marlowe-binaries-api
    , marlowe-contract-store:api
    , marlowe-contrib:optparse

    , marlowe-object
    , marlowe-plutus ^>=0.2
    , marlowe-runtime
    , marlowe-transactions
    , monad-control ^>=1
    , mtl
    , network-uri
    , nonempty-containers
    , optparse-applicative
    , openapi3 >=3.2.5
    , ouroboros-consensus
    , ouroboros-network:{api}
    , parsec
    , pipes
    , plutus-core
    , plutus-ledger-api
    , plutus-tx
    , postgresql-syntax
    , profunctors
    , scientific
    , semialign
    , semigroups
    , servant ^>=0.20
    , servant-client ^>=0.20
    , servant-client-core ^>=0.20
    , servant-openapi3 ^>=2.0
    , servant-pagination >=2.5 && <3
    , servant-pipes ^>=0.16
    , servant-server ^>=0.20
    , template-haskell
    , text
    , time
     , transformers
     , transformers-base
     , unliftio
     , unliftio-core
     , unordered-containers
    , wai
    , wai-cors
    , wai-extra
    , wai-logger
    , warp
    , witherable
    , variations
    , vector
    , yaml

executable cli
  import:          lang
  hs-source-dirs:  client
  main-is:         Main.hs
  ghc-options:
    -threaded -j8
  other-modules:
    Commands
    Commands.Formatters.Servant
    Commands.ApplyInputs
    Commands.Init
    Commands.GetContract
    Commands.GetTransactions
    Commands.Next
    Commands.UploadContractSource
    Commands.GetContractSource
    Commands.GetContractSourceAdjacency
    Commands.GetContractSourceClosure
    Commands.Options.Address
    Commands.Options.CardanoNode
    Commands.Options.ContractId
    Commands.Options.MessageFormat
    Commands.Options.Port
    Commands.Options.ServantClientRunner
    Paths_marlowe_runtime
  build-depends:
    , aeson
    , aeson-pretty
    , base
    , base16-bytestring
    , bytestring
    , cardano-api
    , case-insensitive
    , containers
    , deepseq
    , directory
    , errors
    , filepath
    , http-client
    , marlowe-object
    , marlowe-contrib:optparse
    , marlowe-plutus
    , marlowe-runtime
    , marlowe-transactions
    , mtl
    , newtype
    , optparse-applicative
    , parsec
    , pipes
    , servant
    , servant-client
    , servant-client-core
    , text
    , time
    , transformers
    , yaml

library gen
  import:          lang
  hs-source-dirs:  gen
  visibility:      public
  exposed-modules:
    Language.Marlowe.Runtime.Web.Gen
  build-depends:
    , aeson
    , base
    , bytestring
    , cardano-api
    , cardano-api:gen
    , hedgehog-quickcheck
    , marlowe-object:gen
    , marlowe-plutus:{marlowe-testing, marlowe-plutus}
    , marlowe-runtime
    , marlowe-transactions:gen
    , openapi3
    , regex-posix
    , QuickCheck
    , quickcheck-instances
    , servant
    , text

test-suite test
  import:          lang
  type:           exitcode-stdio-1.0
  main-is:        Spec.hs
  hs-source-dirs:  test
  other-modules:
    -- Language.Marlowe.Runtime.Transaction.BuildConstraintsSpec
    -- Language.Marlowe.Runtime.Transaction.BuildConstraintsSpec.PropertyBased
    Language.Marlowe.Runtime.Web.Contract.APISpec
  build-depends:
    , aeson
    , base
    , cardano-api
    , hspec
    , hspec-core
    , marlowe-runtime:{gen, marlowe-runtime}
    , QuickCheck
