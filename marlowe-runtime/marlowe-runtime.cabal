cabal-version: 3.4
name:          marlowe-runtime
version:       0.1.0.0
license:       Apache-2.0
build-type:    Simple
maintainer:    paluh (aka Tomasz Rybarczyk)
stability:     experimental
author:        Jamie Bertram, Tomasz Rybarczyk
synopsis:      Self-contained Marlowe Runtime Web API
category:      Language

source-repository head
  type:     git
  location: https://github.com/marlowe-lang/marlowe-plutus

common lang
  default-language:   Haskell2010
  default-extensions:
    ApplicativeDo
    BangPatterns
    BlockArguments
    ConstraintKinds
    DataKinds
    DefaultSignatures
    DeriveAnyClass
    DeriveDataTypeable
    DeriveFoldable
    DeriveFunctor
    DeriveGeneric
    DeriveLift
    DeriveTraversable
    DerivingStrategies
    DerivingVia
    DoAndIfThenElse
    DuplicateRecordFields
    ExplicitForAll
    ExplicitNamespaces
    ExistentialQuantification
    FlexibleContexts
    FlexibleInstances
    GADTs
    GeneralizedNewtypeDeriving
    ImportQualifiedPost
    ImpredicativeTypes
    KindSignatures
    LambdaCase
    MultiParamTypeClasses
    NamedFieldPuns
    NumericUnderscores
    OverloadedStrings
    OverloadedRecordDot
    PatternSynonyms
    PolyKinds
    RankNTypes
    RecordWildCards
    ScopedTypeVariables
    StandaloneDeriving
    -- StrictData
    TupleSections
    TypeApplications
    TypeFamilies
    TypeOperators
    ViewPatterns

  ghc-options:
    -Wall -Wnoncanonical-monad-instances
    -Wincomplete-uni-patterns -Wincomplete-record-updates
    -Wredundant-constraints -Widentities -Werror

library
  import:          lang
  ghc-options:
    -threaded -j8
  hs-source-dirs:  src
  build-depends:
    , aeson
    , async-components
    , base
    , base16
    , base16-aeson
    , binary
    , bytestring
    , cardano-api
    , cardano-binary
    , cardano-crypto-class
    , cardano-ledger-alonzo
    , cardano-ledger-api
    , cardano-ledger-binary
    , cardano-ledger-core
    , filepath
    , filelock
    , co-log
    , containers
    , deepseq
    , dlist
    , errors
    , exceptions
    , foldl
    , hashable
    , hasql
    , hasql-dynamic-syntax
    , hasql-implicits
    , hasql-th >=0.5
    , hasql-transaction
    , http-media
    , insert-ordered-containers
    , lens
    , lens-aeson
    , log-base
    , marlowe-contract-store:api
    , marlowe-indexer:db
    , marlowe-object
    , marlowe-plutus ^>=0.2
    , marlowe-transactions
    , monad-control ^>=1
    , mtl
    , network-uri
    , nonempty-containers
    , openapi3 ^>=3.2.5
    , ouroboros-consensus
    , ouroboros-network:{api}
    , parsec
    , pipes
    , plutus-core
    , plutus-ledger-api
    , plutus-tx
    , postgresql-syntax
    , profunctors
    , scientific
    , semialign
    , semigroups
    , servant ^>=0.20
    , servant-client ^>=0.20
    , servant-client-core ^>=0.20
    , servant-openapi3
    , servant-pagination >=2.5 && <3
    , servant-pipes ^>=0.16
    , servant-server ^>=0.20
    , template-haskell
    , text
    , time
    , transformers
    , transformers-base
    , unliftio
    , unliftio-core
    , unordered-containers
    , uuid
    , wai
    , zlib
    , witherable
    , variations
    , vector

  other-modules:
    Paths_marlowe_runtime

  exposed-modules:
    Language.Marlowe.Runtime.Contract.Api
    Language.Marlowe.Runtime.Contract.Store
    Language.Marlowe.Runtime.Contract.Store.Memory
    Language.Marlowe.Runtime.Contract.TransferServer
    Language.Marlowe.Runtime.Query
    Language.Marlowe.Runtime.Query.Database
    Language.Marlowe.Runtime.Query.Database.PostgreSQL
    Language.Marlowe.Runtime.Query.Database.PostgreSQL.GetContractState
    Language.Marlowe.Runtime.Query.Database.PostgreSQL.GetCreateStep
    Language.Marlowe.Runtime.Query.Database.PostgreSQL.GetEraHistory
    Language.Marlowe.Runtime.Query.Database.PostgreSQL.GetHeaders
    Language.Marlowe.Runtime.Query.Database.PostgreSQL.GetIndexerTip
    Language.Marlowe.Runtime.Query.Database.PostgreSQL.GetIntersection
    Language.Marlowe.Runtime.Query.Database.PostgreSQL.GetIntersectionForContract
    Language.Marlowe.Runtime.Query.Database.PostgreSQL.GetMarloweTip
    Language.Marlowe.Runtime.Query.Database.PostgreSQL.GetNetworkId
    Language.Marlowe.Runtime.Query.Database.PostgreSQL.GetNodeTip
    Language.Marlowe.Runtime.Query.Database.PostgreSQL.GetProtocolParameters
    Language.Marlowe.Runtime.Query.Database.PostgreSQL.GetSystemStart
    Language.Marlowe.Runtime.Query.Database.PostgreSQL.GetPayout
    Language.Marlowe.Runtime.Query.Database.PostgreSQL.GetPayouts
    Language.Marlowe.Runtime.Query.Database.PostgreSQL.GetRoleCurrencies
    Language.Marlowe.Runtime.Query.Database.PostgreSQL.GetTipForContract
