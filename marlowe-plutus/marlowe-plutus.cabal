cabal-version: 3.4
name:          marlowe-plutus
version:       0.3.0
license:       Apache-2.0
build-type:    Simple
maintainer:    tomasz.rybarczyk@marlowe-lang.org
stability:     experimental
author:        Alexander Nemish, Brian Bush, Tomasz Rybarczyk, Pablo Lamela
synopsis:      Current reference implementation of Marlowe in Plinth
category:      Language
license-files:
  LICENSE
  NOTICE

data-files:
  -- benchmarks/rolepayout/*.benchmark
  -- benchmarks/semantics/*.benchmark

  marlowe-testing/reference/data/*.contract
  marlowe-testing/reference/data/*.paths
  marlowe-testing/data/mainnet-protocol-params.json

  test/contract.json
  test/input.json
  test/Spec/Marlowe/Serialization/golden/swap-contract.json
  test/Spec/Marlowe/Serialization/golden/swap-module.json
  test/state.json

source-repository head
  type:     git
  location: https://github.com/input-output-hk/marlowe-plutus

flag defer-plugin-errors
  description:
    Defer errors from the plugin, useful for things like Haddock that can't handle it.

  default:     False
  manual:      True

flag profile-plutus
  description: Enable Plutus profiling for Marlowe validators.
  default:     False
  manual:      True

flag asdata-case
  description: Use `PlutusTx.asData` for `Case`.
  default:     True
  manual:      True

common lang
  default-language:   Haskell2010
  default-extensions:
    BangPatterns
    BlockArguments
    ConstraintKinds
    DataKinds
    DefaultSignatures
    DeriveAnyClass
    DeriveDataTypeable
    DeriveFoldable
    DeriveFunctor
    DeriveGeneric
    DeriveLift
    DeriveTraversable
    DerivingStrategies
    DerivingVia
    DoAndIfThenElse
    DuplicateRecordFields
    ExplicitForAll
    FlexibleContexts
    FlexibleInstances
    GADTs
    GeneralizedNewtypeDeriving
    ImportQualifiedPost
    KindSignatures
    LambdaCase
    MultiParamTypeClasses
    NamedFieldPuns
    NumericUnderscores
    OverloadedStrings
    OverloadedRecordDot
    PatternSynonyms
    RankNTypes
    RecordWildCards
    ScopedTypeVariables
    StandaloneDeriving
    TupleSections
    TypeApplications
    TypeFamilies
    TypeOperators
    ViewPatterns

  ghc-options:
    -Wall -Wnoncanonical-monad-instances
    -Wincomplete-uni-patterns -Wincomplete-record-updates
    -Wredundant-constraints -Widentities -Werror

  if flag(profile-plutus)
    ghc-options: -fplugin-opt PlutusTx.Plugin:conservative-optimisation

  if flag(profile-plutus)
    ghc-options: -fplugin-opt PlutusTx.Plugin:profile-all

library
  import:          lang
  hs-source-dirs:  src
  build-depends:
    , aeson
    , base >=4.9 && <5
    , bech32 >=1.1 && <2
    , base16-aeson ==0.1.0.0
    , base16-bytestring
    , bytestring
    -- FIXME: We should drop this dependency by:
    -- * Providing our own implementation of plutus data serialization (even if it is a copy)
    -- * Moving this dependency to the test suite only
    -- * Testing that our implementation is compatible with cardano-api's one
    , cardano-api
    , cardano-crypto-class
    , containers
    , deepseq
    , deriving-aeson
    , flat
    , ilist ==0.4.0.1
    , lens
    , marlowe-contrib:foldable-traversable
    , mtl ^>=2.3.1
    , multiplate ==0.0.3
    , newtype-generics
    , plutus-core
    , plutus-ledger-api
    , plutus-tx
    , profunctors >=5.6.3
    , range ==0.3.0.2
    , scientific
    , serialise
    , sbv
    , template-haskell
    , text
    , time ^>= 1.12.2
    , transformers ^>=0.6.1
    , wl-pprint >=1.2 && <2
    , either ^>=5.0.3

  exposed-modules:
    Paths_marlowe_plutus

    Marlowe.Plutus.Analysis.FSSemantics
    Marlowe.Plutus.Analysis.Safety.Ledger
    Marlowe.Plutus.Analysis.Safety.Ledger.Validators
    Marlowe.Plutus.Analysis.Safety.Transaction
    Marlowe.Plutus.Analysis.Safety.Types
    Marlowe.Plutus.Analysis.Safety.Types.Validator
    -- Marlowe.Plutus.AssocMap
    Marlowe.Plutus.Contrib.PlutusTx.Debugging.Trace
    Marlowe.Plutus.Contrib.PlutusTx.Dict
    Marlowe.Plutus.Contrib.PlutusTx.KeyHashedDict
    Marlowe.Plutus.FindInputs
    Marlowe.Plutus.Foldings
    Marlowe.Plutus.Merkle
    Marlowe.Plutus.Next
    Marlowe.Plutus.Next.Applicables
    Marlowe.Plutus.Next.Applicables.Bound
    Marlowe.Plutus.Next.Applicables.CanChoose
    Marlowe.Plutus.Next.Applicables.CanDeposit
    Marlowe.Plutus.Next.Applicables.CanNotify
    Marlowe.Plutus.Next.CanReduce
    Marlowe.Plutus.Next.Indexed
    Marlowe.Plutus.Next.IsMerkleizedContinuation
    Marlowe.Plutus.OpenRoles
    Marlowe.Plutus.Plate
    Marlowe.Plutus.Pretty
    Marlowe.Plutus.RolePayout
    Marlowe.Plutus.RoleTokens
    Marlowe.Plutus.RoleTokens.Types
    Marlowe.Plutus.Scripts
    Marlowe.Plutus.Scripts.Types
    Marlowe.Plutus.Semantics
    Marlowe.Plutus.Semantics.Types
    Marlowe.Plutus.Semantics.Types.Address

  if flag(asdata-case)
    cpp-options: -DASDATA_CASE

-- Golden tests, fixtures, generators
library marlowe-testing
  import:             lang
  hs-source-dirs:     marlowe-testing
  visibility:        public
  other-modules:
    Paths_marlowe_plutus
  exposed-modules:
    Marlowe.Plutus.Testing.Common
    Marlowe.Plutus.Testing.Contrib.Data.Functor
    Marlowe.Plutus.Testing.Contrib.Integer.Arbitrary
    Marlowe.Plutus.Testing.Contrib.PlutusTx.Arbitrary
    Marlowe.Plutus.Testing.Contrib.PlutusTx.Debugging.Aeson
    Marlowe.Plutus.Testing.Contrib.PlutusTx.Lens
    Marlowe.Plutus.Testing.Contrib.PlutusTx.PlutusTransaction
    Marlowe.Plutus.Testing.Data.Jsonable
    Marlowe.Plutus.Testing.ProtocolParams
    Marlowe.Plutus.Testing.Reference
    Marlowe.Plutus.Testing.Scripts
    Marlowe.Plutus.Testing.Semantics.Arbitrary
    Marlowe.Plutus.Testing.Semantics.AssocMap
    Marlowe.Plutus.Testing.Semantics.Golden
    Marlowe.Plutus.Testing.Semantics.Golden.Escrow
    Marlowe.Plutus.Testing.Semantics.Golden.Negative
    Marlowe.Plutus.Testing.Semantics.Golden.Pangram
    Marlowe.Plutus.Testing.Semantics.Golden.Swap
    Marlowe.Plutus.Testing.Semantics.Golden.Trivial
    Marlowe.Plutus.Testing.Semantics.Golden.ZeroCouponBond
    Marlowe.Plutus.Testing.Semantics.Next.Arbitrary
    Marlowe.Plutus.Testing.Semantics.Path
    Marlowe.Plutus.Testing.Semantics.Util
    Marlowe.Plutus.Testing.Service
    Marlowe.Plutus.Testing.Service.Random
    Marlowe.Plutus.Testing.Service.Serialization
    Marlowe.Plutus.Testing.Service.Types
    Marlowe.Plutus.Testing.Transactions

  build-depends:
    , aeson
    , aeson-pretty
    , base >=4.9 && <5
    , base16-aeson ==0.1.0.0
    , base16-bytestring
    , bytestring
    , cardano-api
    , cardano-crypto-class
    , containers ^>=0.6.5
    , data-default
    , directory ^>=1.3
    , filepath ^>=1.4
    , hspec
    , hspec-core
    , lens
    , marlowe-plutus:{marlowe-plutus}
    , mtl >=2.2 && <3
    , QuickCheck >=2.14 && <3
    , quickcheck-instances
    , plutus-core
    , plutus-ledger-api
    , plutus-tx
    , serialise
    , tasty-quickcheck ^>=0.11
    , text
    , transformers
    , vector
    , yaml

  build-tool-depends: hspec-discover:hspec-discover
  ghc-options:        -threaded

executable marlowe-testing-reference
  import:         lang
  hs-source-dirs: marlowe-testing/reference
  main-is:        Main.hs
  build-depends:
    , base >=4.9 && <5
    , directory
    , filepath
    , marlowe-plutus:{marlowe-testing}
    , mtl >=2.2 && <3

-- The core spec for the interpreter
test-suite marlowe-plutus-test
  import:         lang
  hs-source-dirs: test
  main-is:        Spec.hs
  type:               exitcode-stdio-1.0
  other-modules:
    Paths_marlowe_plutus
    Spec.PlutusTx
    Spec.PlutusTx.AssocMap
    Spec.PlutusTx.MList
    Spec.PlutusTx.Prelude
    Spec.PlutusTx.ScriptContext
    Spec.PlutusTx.Specification
    Spec.PlutusTx.Value
    Spec.Marlowe.Marlowe
    Spec.Marlowe.Merkle
    Spec.Marlowe.Plate
    Spec.Marlowe.Semantics
    Spec.Marlowe.Semantics.Compute
    Spec.Marlowe.Semantics.Entropy
    Spec.Marlowe.Semantics.Functions
    Spec.Marlowe.Semantics.Golden.Tests
    Spec.Marlowe.Semantics.Next
    Spec.Marlowe.Semantics.Next.Common.Isomorphism
    Spec.Marlowe.Semantics.Next.Common.QuickCheck
    Spec.Marlowe.Semantics.Next.Common.Tuple
    Spec.Marlowe.Semantics.Next.Contract
    Spec.Marlowe.Semantics.Next.Contract.Generator
    Spec.Marlowe.Semantics.Next.Contract.When
    Spec.Marlowe.Semantics.Next.Contract.When.Choice
    Spec.Marlowe.Semantics.Next.Contract.When.Deposit
    Spec.Marlowe.Semantics.Next.Contract.When.Notify
    Spec.Marlowe.Semantics.Path.Tests
    Spec.Marlowe.Serialization
    Spec.Marlowe.Service.Isabelle
    Spec.Marlowe.StaticAnalysis
    Spec.Marlowe.StaticAnalysis.Regression

  build-depends:
    , aeson
    , base >=4.9 && <5
    , bytestring
    , cardano-api
    , containers ^>=0.6.5
    , data-default
    , filepath ^>=1.4
    , hint ^>=0.9
    , hspec
    , ilist ==0.4.0.1
    , lens >=5.2 && <6
    , marlowe-plutus:{marlowe-plutus, marlowe-testing}
    , marlowe-spec-test ==0.1.0.3
    , mtl >=2.2 && <3
    , plutus-ledger-api
    , plutus-tx
    , QuickCheck >=2.14 && <3
    , quickcheck-instances ^>=0.3.29
    , sbv
    , tasty ^>=1.5
    , tasty-hspec
    , tasty-hunit ^>=0.10
    , tasty-quickcheck ^>=0.11
    , text
    , type-iso ==1.0.1.0

