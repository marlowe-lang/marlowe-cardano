cabal-version: 3.4
name:          marlowe-binaries
version:       0.2.0.0
license:       Apache-2.0
build-type:    Simple
maintainer:    tomasz.rybarczyk@marlowe-lang.org
stability:     experimental
author:        Alexander Nemish, Brian Bush, Tomasz Rybarczyk, Pablo Lamela
synopsis:      Marlowe plutus validators
category:      Language
license-files:
  LICENSE
  NOTICE

data-files:
  benchmarks/rolepayout/*.benchmark
  benchmarks/semantics/*.benchmark
  data/mainnet-protocol-params.json

source-repository head
  type:     git
  location: https://github.com/input-output-hk/marlowe-plutus

flag defer-plugin-errors
  description:
    Defer errors from the plugin, useful for things like Haddock that can't handle it.

  default:     False
  manual:      True

flag profile-plutus
  description: Enable Plutus profiling for Marlowe validators.
  default:     False
  manual:      True

flag check-preconditions
  description:
    Validator checks whether preconditions are satisfied for the Marlowe state.

  default:     True
  manual:      True

flag check-positive-balances
  description:
    Validator checks whether any account balances are non-positive in the Marlowe state.

  default:     True
  manual:      True

flag check-duplicate-accounts
  description:
    Validator checks whether any accounts are duplicated in the Marlowe state.

  default:     True
  manual:      True

flag check-duplicate-choices
  description:
    Validator checks whether any choices are duplicated in the Marlowe state.

  default:     True
  manual:      True

flag check-duplicate-bindings
  description:
    Validator checks whether any bound values are duplicated in the Marlowe state.

  default:     True
  manual:      True

flag asdata-case
  description: Use `PlutusTx.asData` for `Case`.
  default:     True
  manual:      True

common lang
  default-language:   Haskell2010
  default-extensions:
    BangPatterns
    BlockArguments
    ConstraintKinds
    DataKinds
    DefaultSignatures
    DeriveAnyClass
    DeriveDataTypeable
    DeriveFoldable
    DeriveFunctor
    DeriveGeneric
    DeriveLift
    DeriveTraversable
    DerivingStrategies
    DerivingVia
    DoAndIfThenElse
    DuplicateRecordFields
    ExplicitForAll
    FlexibleContexts
    FlexibleInstances
    GeneralizedNewtypeDeriving
    ImportQualifiedPost
    LambdaCase
    MultiParamTypeClasses
    NamedFieldPuns
    NumericUnderscores
    OverloadedRecordDot
    OverloadedStrings
    PatternSynonyms
    RankNTypes
    RecordWildCards
    ScopedTypeVariables
    StandaloneDeriving
    TupleSections
    TypeApplications
    TypeFamilies
    TypeOperators
    ViewPatterns

  ghc-options:
    -Wall -Wnoncanonical-monad-instances
    -Wincomplete-uni-patterns -Wincomplete-record-updates
    -Wredundant-constraints -Widentities -Werror

  if flag(profile-plutus)
    ghc-options: -fplugin-opt PlutusTx.Plugin:conservative-optimisation

  if flag(profile-plutus)
    ghc-options: -fplugin-opt PlutusTx.Plugin:profile-all

library
  import:          lang
  hs-source-dirs:  src
  build-depends:
    , base
    , bytestring
    , cardano-crypto-class
    , marlowe-plutus:{marlowe-plutus} ^>=0.2
    , plutus-core
    , plutus-ledger-api
    , plutus-tx
    , plutus-tx-plugin

  exposed-modules:
    Marlowe.Plutus.Binaries
    Marlowe.Plutus.Binaries.Core
    Marlowe.Plutus.Binaries.Devel
    Marlowe.Plutus.Binaries.Production

library marlowe-binaries-api
  import:          lang
  hs-source-dirs:  marlowe-binaries-api
  visibility:      public
  other-modules:
    Paths_marlowe_binaries

  exposed-modules:
    Marlowe.Plutus.Binaries.Api.Benchmark
    Marlowe.Plutus.Binaries.Api.Compile

  other-modules:
    Marlowe.Plutus.Binaries.Api.Core

  build-depends:
    , aeson
    , base16-aeson
    , aeson-pretty
    , base
    , base16-bytestring
    , bytestring
    , cardano-api
    , cardano-crypto-class
    , serialise
    , directory
    , filepath
    , marlowe-plutus:{marlowe-plutus, marlowe-testing}
    , marlowe-contrib:optparse
    , QuickCheck
    , plutus-core
    , plutus-ledger-api
    , plutus-tx
    , scientific
    , text
    , transformers
    , vector

test-suite marlowe-binaries-test
  import:             lang
  type:               exitcode-stdio-1.0
  main-is:            Main.hs
  hs-source-dirs:     test
  other-modules:
    Marlowe.Plutus.BinariesSpec

  build-depends:
    , base
    , bytestring
    , containers
    , lens
    , hspec
    , QuickCheck
    , cardano-api
    , marlowe-binaries:marlowe-binaries-api
    , plutus-core
    , plutus-ledger-api
    , plutus-tx
    , marlowe-binaries
    , marlowe-plutus:{marlowe-plutus, marlowe-testing}
    , these
    , transformers

  ghc-options:        -threaded

executable marlowe-binaries
  import:          lang
  hs-source-dirs:  app
  main-is:         Main.hs
  other-modules:
    Commands.Benchmark
    Commands
    Commands.Compile
    Options
    Paths_marlowe_binaries

  build-depends:
    , aeson
    , aeson-pretty
    , base
    , bytestring
    , cardano-api
    , directory
    , filepath
    , marlowe-binaries
    , marlowe-binaries:marlowe-binaries-api
    , marlowe-contrib:optparse
    , marlowe-plutus:{marlowe-plutus, marlowe-testing}
    , optparse-applicative
    , plutus-ledger-api
    , plutus-tx
    , text
    , transformers
    , yaml

  ghc-options: -threaded
