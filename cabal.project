repository cardano-haskell-packages
  url: https://chap.intersectmbo.org/
  secure: True
  root-keys:
    3e0cce471cf09815f930210f7827266fd09045445d65923e6d0238a6cd15126f
    443abb7fb497a134c343faf52f0b659bd7999bc06b7f63fa76dc99d631f9bea1
    a86a1f6ce86c449c46666bda44268677abf29b5b2d2eb5ec7af903ec2f117a82
    bcec67e8e99cabfa7764d75ad9b158d72bfacf70ca1d0ec8bc6b4406d1bf8413
    c00aae8461a256275598500ea0e187588c35a5d5d7454fb57eac18d9edb86a56
    d4a35cd3121aa00d18544bb0ac01c3e1691d618f462c46129271bccf39f7e8ee

-- run `nix flake lock --update-input hackage` after updating the hackage index-state.
-- run `nix flake lock --update-input CHaP` after updating the cardano-haskell-packages index-state.
index-state:
  , hackage.haskell.org 2026-05-26T07:00:45Z
  , cardano-haskell-packages 2026-05-25T13:25:40Z

packages:
  marlowe-binaries
  marlowe-cli
  marlowe-indexer
  marlowe-object
  marlowe-plutus
  marlowe-plutus-extended
  marlowe-runtime
  marlowe-transactions

  libs/async-components
  libs/base16-aeson
  libs/cardano-debug
  libs/log-base-inlined
  libs/hasql-dynamic-syntax
  libs/marlowe-contrib
  libs/multiplate
  libs/plutus-ledger-ada
  libs/plutus-ledger-slot
  libs/variations
  -- libs/sqlite-simple

multi-repl: True

tests: True

test-show-details: direct

-- Let's keep alphabetical order of packages below.

package marlowe-plutus
  tests: True
  ghc-options: -Werror

package postgresql-libpq
  flags: +use-pkg-config

constraints:
    cardano-api ^>=11.0
  , cardano-crypto-class ^>=2.3
  , plutus-core ^>=1.63
  , plutus-ledger-api ^>=1.63
  , validation <1.2

source-repository-package
   type: git
   location: https://github.com/marlowe-lang/marlowe.git
   tag: 7b5b1e900ec53a8eb18747992bec73470704dfcb
   --sha256: sha256-ndrqu+9lwYBxqPq8QrIV63VVUANR9pSMbufkIut1Kik=
   subdir: marlowe-spec-test
           haskell
           isabelle

-- Currently this is the simplest way to get compilation working
source-repository-package
  type: git
  location: https://github.com/palas/haskell-lmdb-mock.git
  tag: c8d61e6eee03ee271e7768c0576110da885aec48
  --sha256: sha256-+gB1MmM6qRApz1p7tFsdvKoAWDrYB4a+bJ9Djm6ieYI=

-- hasql-th 0.5 with ByteString -> Text fix (issue #36)
source-repository-package
  type: git
  location: https://github.com/nikita-volkov/hasql-th
  tag: 8dad116eb3ba13ba5c9d0c6e5d12d231a1cc4c83
  --sha256: 00lv3k45p83ivkk4n1ps6cw1g53qjfrv1qirx1c4n04xnmgggsxj

